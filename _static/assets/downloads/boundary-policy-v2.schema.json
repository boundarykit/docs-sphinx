{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "effect",
    "capability"
  ],
  "properties": {
    "effect": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 1
    }
  }
}
